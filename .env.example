# Copy to .env and fill in. Never commit .env or put a real key in this file.

# Gemini writes the answers (RAG). Without a key, the app shows the curated answers.
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
# Comma-separated; later models are fallbacks.
LLM_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=25

# auto | hybrid | embed | tfidf
NS_BACKEND=auto
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: retrieval score cut-offs per backend
# NS_THRESHOLD_TFIDF=0.12
# NS_THRESHOLD_EMBED=0.35
# NS_THRESHOLD_HYBRID=0.23

# DEBUG | INFO | WARNING
NS_LOG_LEVEL=INFO
